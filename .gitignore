node_modules/
.wrangler/
.claude/
.DS_Store
*.log

# Local secrets. .dev.vars.example is the checked-in template.
.dev.vars
.dev.vars.*
!.dev.vars.example
.cf.env

# Generated by `wrangler types`.
worker-configuration.d.ts

# Personal documents. The CV is served from R2, not from this repo — keeping it
# out means a public clone carries no home address or phone number.
*.pdf
!public/porto/*.pdf

# Portrait master. public/randy.jpg is the optimised copy the site actually
# uses; the 1.5 MB PNG it came from does not belong in git.
public/randy.png

# Scratch captures. `upwork` was a saved HTTP request complete with live session
# tokens — nothing of that shape should ever get near a commit.
upwork
*.har
