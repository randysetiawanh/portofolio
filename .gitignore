node_modules/
.wrangler/
.claude/
.DS_Store
*.log

# Bank memory project. Ditulis untuk sesi yang mau mengubah sesuatu, bukan untuk
# orang yang meng-clone repo ini — README.md yang untuk mereka.
.internal-docs/

# Local secrets. .dev.vars.example is the checked-in template.
.dev.vars
.dev.vars.*
!.dev.vars.example
.cf.env

# Generated by `wrangler types`.
worker-configuration.d.ts

# Personal documents. The CV is served from R2, not from this repo — keeping it
# out means a public clone carries no home address or phone number.
*.pdf
!public/porto/*.pdf

# Scratch. The project sheets moved to ../porto-sheet on 2026-08-10, but keep
# this: anything generated here carries ministry screenshots, and .html is not
# covered by the *.pdf rule above, so the whole directory stays out of a public
# clone. Publishing a sheet is an upload through /admin, not a commit.
tmp/

# Portrait master. public/randy.jpg is the optimised copy the site actually
# uses; the 1.5 MB PNG it came from does not belong in git.
public/randy.png

# Scratch captures. `upwork` was a saved HTTP request complete with live session
# tokens — nothing of that shape should ever get near a commit.
upwork
*.har
